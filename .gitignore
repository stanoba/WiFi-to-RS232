# PlatformIO
.pio
.pioenvs
.piolibdeps
software/.pio/
emulator/.pio/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Editor and IDE directories
.vscode/
.idea/
*.swp
*.bak

# Temporary scratch directory
.temp/
scratch/
.env
*.local.json
.devices.json
config.yaml
config.yml
!config.example.yaml

# CAM and manufacturing outputs
CAMOutputs/

# Release distribution builds
dist/
software/dist/
emulator/dist/

# Compiled binaries & logs
*.bin
*.elf
*.o
*.a

# Allow webflasher release binaries for GitHub Pages
!webflasher/firmware/*.bin
